/* Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

/* Global Image Safety Constraint */
img {
    max-width: 100%;
    height: auto;
    box-sizing: border-box;
}

/* ── Global Focus & Tap-Highlight Management ── */
a, button, [role="button"], summary, select,
input[type="submit"], input[type="button"], input[type="reset"],
.card, .card-link, .kpi-card, .week-card, .page-btn,
.recent-ticket-link, .ticket, .nav-links a,
.reopen-action-btn, .delete-btn, .csat-submit-btn,
.btn-csat-change, .btn-csat-remove,
.btn-prompt-update, .btn-prompt-keep, .btn-prompt-remove,
.action-btn-sm, .upload-preview-remove, .image-modal-close {
    -webkit-tap-highlight-color: transparent;
}

/* Mouse / touch click — no outline */
a:focus:not(:focus-visible),
button:focus:not(:focus-visible),
[role="button"]:focus:not(:focus-visible),
summary:focus:not(:focus-visible),
select:focus:not(:focus-visible),
input[type="submit"]:focus:not(:focus-visible),
input[type="button"]:focus:not(:focus-visible),
input[type="reset"]:focus:not(:focus-visible),
.card:focus:not(:focus-visible),
.card-link:focus:not(:focus-visible),
.kpi-card:focus:not(:focus-visible),
.week-card:focus:not(:focus-visible),
.page-btn:focus:not(:focus-visible),
.recent-ticket-link:focus:not(:focus-visible),
.ticket:focus:not(:focus-visible),
.nav-links a:focus:not(:focus-visible),
.reopen-action-btn:focus:not(:focus-visible),
.delete-btn:focus:not(:focus-visible),
.csat-submit-btn:focus:not(:focus-visible),
.btn-csat-change:focus:not(:focus-visible),
.btn-csat-remove:focus:not(:focus-visible),
.btn-prompt-update:focus:not(:focus-visible),
.btn-prompt-keep:focus:not(:focus-visible),
.btn-prompt-remove:focus:not(:focus-visible),
.action-btn-sm:focus:not(:focus-visible),
.upload-preview-remove:focus:not(:focus-visible),
.image-modal-close:focus:not(:focus-visible) {
    outline: none;
    box-shadow: none;
}

/* Keyboard Tab navigation — soft blue ring */
a:focus-visible,
button:focus-visible,
[role="button"]:focus-visible,
summary:focus-visible,
.card:focus-visible,
.card-link:focus-visible,
.kpi-card:focus-visible,
.week-card:focus-visible,
.page-btn:focus-visible,
.recent-ticket-link:focus-visible,
.ticket:focus-visible,
.nav-links a:focus-visible,
.reopen-action-btn:focus-visible,
.delete-btn:focus-visible,
.csat-submit-btn:focus-visible,
.btn-csat-change:focus-visible,
.btn-csat-remove:focus-visible,
.btn-prompt-update:focus-visible,
.btn-prompt-keep:focus-visible,
.btn-prompt-remove:focus-visible,
.action-btn-sm:focus-visible,
.upload-preview-remove:focus-visible,
.image-modal-close:focus-visible {
    outline: 2px solid #1976d2;
    outline-offset: 2px;
}

/* Text inputs & textareas — blue border on focus, never black */
textarea:focus,
input:focus,
.csat-feedback-input:focus {
    outline: none;
}

/* Body */
body {
    min-height: 100vh;
    background: linear-gradient(135deg, #e3f2fd, #f4f6f9);
    overflow-x:hidden;
}

/* Container */
.container {
    width: 100%;
    max-width: 380px;
    background: #ffffff;
    padding: 30px 25px;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

/* Dashboard Container */
.dashboard-container {
    width: 95%;
    max-width: 1100px;
    background: #ffffff;
    padding: 40px;/* 30px */
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
}

/* Portal Container */
.portal-container{
    width:100%;
    max-width:980px;
    background:#fff;
    padding:35px;
    border-radius:16px;
    box-shadow:0 8px 25px rgba(0,0,0,.1);
}

/* Heading */
h2 {
    text-align: center;
    margin-bottom: 20px;
    color: #0d47a1;
}

/* Inputs */
input {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    font-size: 14px;
    transition: all 0.3s ease;
}

/* Input focus */
input:focus {
    border-color: #1976d2;
    outline: none;
    box-shadow: 0 0 6px rgba(25, 118, 210, 0.3);
}

/* Button */
button {
    width: 100%;
    padding: 12px;
    background: #1976d2;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
    transition: 0.3s ease;
}

/* Button hover */
button:hover {
    background: #0d47a1;
}

/* Links */
.link {
    text-align: center;
    margin-top: 12px;
}

.link p {
    font-size: 14px;
    color: #555;
}

.link a {
    text-decoration: none;
    color: #1976d2;
    font-weight: 500;
}

.link a:hover {
    text-decoration: underline;
}

/* Small screens */
@media (max-width: 500px) {
    .container {
        width: 100%;
        padding: 25px 20px;
    }

    h2 {
        font-size: 20px;
    }

    input, button {
        font-size: 14px;
        padding: 11px;
    }
}

/* Navbar */
.navbar {
    width: 100%;
    background: #0d47a1;
    color: white;
    padding: 15px 20px; /*15px 20px */
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.navbar h3 {
    margin: 0;
}

.nav-links a {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    font-size: 14px;
}

.nav-links a:hover {
    opacity: 0.8;
    /*text-decoration: underline;*/
}

.logout-link {
    background: #607d8b;
    padding: 6px 10px;
    border-radius: 4px;
}

/* submit_ticket.php */
textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    margin-bottom: 15px;
    font-size: 14px;
}

/*.main-content {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 100px; 
}*/

.main-content{
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding:40px 20px;
}

.nav-links a.active {
    border-bottom: 2px solid #fff;
    padding-bottom: 2px;
}

/* Attachments */
.file-upload-container {
    margin-bottom: 18px;
}

.file-input-label {
    display: block;
    margin: 15px 0 6px;
    font-weight: 600;
    color: #1f2937;
    font-size: 14px;
}

.file-input-help {
    font-size: 12px;
    color: #666;
    margin-top: 4px;
    margin-bottom: 15px;
}

.custom-file-input {
    width: 100%;
    padding: 10px;
    background: #f8fbff;
    border: 1.5px dashed #90caf9;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    color: #333;
    transition: all 0.25s ease;
}

.custom-file-input:hover {
    border-color: #1976d2;
    background: #f0f7ff;
}

/* Custom Attachment Button */
.attach-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: #f0f4f9;
    border: 1.5px dashed #90caf9;
    border-radius: 8px;
    color: #1976d2;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.25s ease;
}

.attach-btn:hover {
    background: #e3f2fd;
    border-color: #1976d2;
    color: #0d47a1;
}

/* Pre-Upload Preview Card */
.upload-preview-card {
    display: none;
    margin-top: 12px;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    align-items: center;
    gap: 12px;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    overflow: hidden;
}

.upload-preview-thumb {
    width: 60px !important;
    height: 60px !important;
    min-width: 60px !important;
    max-width: 60px !important;
    min-height: 60px !important;
    max-height: 60px !important;
    object-fit: cover !important;
    border-radius: 6px;
    border: 1px solid #d0d7de;
    flex-shrink: 0 !important;
    display: block !important;
}

.upload-preview-info {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: #333;
    max-width: 220px;
    overflow: hidden;
}

.upload-preview-name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.upload-preview-size {
    font-size: 11px;
    color: #777;
}

.upload-preview-remove {
    background: #ffebee;
    border: 1px solid #ffcdd2;
    color: #c62828;
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-left: 8px;
    font-size: 14px;
    transition: 0.2s;
    outline: none;
}

.upload-preview-remove:hover {
    background: #ef5350;
    color: #fff;
}

.attachment-container {
    margin-top: 14px;
    padding: 12px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    max-width: 100%;
    box-sizing: border-box;
}

.attachment-title {
    font-size: 13px;
    font-weight: 600;
    color: #0d47a1;
    display: flex;
    align-items: center;
    gap: 6px;
}

.attachment-image-link {
    width: 220px;
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid #d0d7de;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    display: block;
    background: #fff;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
}

.attachment-image-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
}

.attachment-image-thumb {
    max-width: 100%;
    width: 100%;
    height: 140px;
    object-fit: cover;
    border-radius: 8px;
    display: block;
    transition: transform 0.3s ease;
}

.attachment-image-link:hover .attachment-image-thumb {
    transform: scale(1.06);
}

.attachment-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(13, 71, 161, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 22px;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
}

.attachment-image-link:hover .attachment-overlay {
    opacity: 1;
}

.attachment-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
}

.attachment-actions a {
    color: #1976d2;
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
}

.attachment-actions a:hover {
    text-decoration: underline;
}

/* Lightbox Modal */
.image-modal {
    position: fixed;
    z-index: 9999;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(4px);
    display: none;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
}

.image-modal.active {
    display: flex;
}

.image-modal-content {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    object-fit: contain;
    animation: zoomInModal 0.25s ease-out;
}

@keyframes zoomInModal {
    from {
        transform: scale(0.92);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.image-modal-close {
    position: absolute;
    top: 20px;
    right: 25px;
    color: #fff;
    font-size: 32px;
    font-weight: bold;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.4);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.2s;
    line-height: 1;
}

.image-modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #ff5252;
}

/* Select Inputs & Form Rows */
select {
    width: 100%;
    padding: 12px;
    margin-bottom: 15px;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    font-size: 14px;
    background: #ffffff;
    color: #333;
    outline: none;
    transition: all 0.3s ease;
    cursor: pointer;
}

select:focus {
    border-color: #1976d2;
    box-shadow: 0 0 6px rgba(25, 118, 210, 0.3);
}

.form-row {
    display: flex;
    gap: 15px;
    margin-bottom: 5px;
}

.form-group {
    flex: 1;
}

@media (max-width: 600px) {
    .form-row {
        flex-direction: column;
        gap: 0;
    }
}

/* Category & Priority Badges */
.category-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    background: #e3f2fd;
    color: #0d47a1;
    border: 1px solid #bbdefb;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.priority-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}

.priority-urgent {
    background: #ffebee;
    color: #c62828;
    border: 1px solid #ffcdd2;
}

.priority-high {
    background: #fff3e0;
    color: #e65100;
    border: 1px solid #ffe0b2;
}

.priority-medium {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #c8e6c9;
}

.priority-low {
    background: #f5f5f5;
    color: #616161;
    border: 1px solid #e0e0e0;
}

.ticket-meta-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 6px;
}

/* ==========================================================================
   Search & Filter Bar Styles
   ========================================================================== */
.search-filter-bar {
    background: #ffffff;
    border: 1px solid #d6e8ff;
    border-radius: 12px;
    padding: 18px 20px;
    margin-bottom: 25px;
    box-shadow: 0 4px 14px rgba(25, 118, 210, 0.06);
}

.search-filter-bar .filter-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.search-filter-bar .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: flex-end;
}

.search-filter-bar .search-group {
    flex: 2;
    min-width: 220px;
}

.search-filter-bar .search-group label,
.search-filter-bar .filter-select-item label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 6px;
}

.search-filter-bar .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
}

.search-filter-bar .search-input-wrapper .search-icon {
    position: absolute;
    left: 12px;
    color: #94a3b8;
    font-size: 14px;
    pointer-events: none;
}

.search-filter-bar .search-input-wrapper input {
    width: 100%;
    padding: 10px 14px 10px 36px;
    margin-bottom: 0;
    border: 1px solid #cfd8dc;
    border-radius: 8px;
    font-size: 14px;
    background: #f8fafc;
    transition: all 0.25s ease;
}

.search-filter-bar .search-input-wrapper input:focus {
    background: #ffffff;
    border-color: #1976d2;
    box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.15);
}

.search-filter-bar .filter-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    flex: 3;
    min-width: 280px;
    align-items: flex-end;
}

.search-filter-bar .filter-select-item {
    flex: 1;
    min-width: 135px;
}

.search-filter-bar .filter-select-item select {
    width: 100%;
    padding: 10px 12px;
    margin-bottom: 0;
    border: 1px solid #cfd8dc;
    border-radius: 8px;
    font-size: 13px;
    background-color: #f8fafc;
    color: #333;
    transition: all 0.25s ease;
    height: 42px;
}

.search-filter-bar .filter-select-item select:focus {
    background-color: #ffffff;
    border-color: #1976d2;
    box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.15);
}

.search-filter-bar .filter-buttons {
    display: flex;
    gap: 8px;
    align-items: center;
}

.search-filter-bar .filter-btn {
    width: auto;
    padding: 10px 18px;
    margin-bottom: 0;
    background: #1976d2;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
    white-space: nowrap;
    height: 42px;
}

.search-filter-bar .filter-btn:hover {
    background: #0d47a1;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(25, 118, 210, 0.25);
}

.search-filter-bar .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    height: 42px;
    box-sizing: border-box;
}

.search-filter-bar .reset-btn:hover {
    background: #e2e8f0;
    color: #1e293b;
    border-color: #94a3b8;
    text-decoration: none;
}

/* ==========================================================================
   Pagination Styles
   ========================================================================== */
.pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
    margin-top: 25px;
    margin-bottom: 15px;
    flex-wrap: wrap;
}

.page-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 36px;
    height: 36px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 600;
    color: #1976d2;
    background: #ffffff;
    border: 1px solid #bbdefb;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    box-sizing: border-box;
}

.page-btn:hover {
    background: #e3f2fd;
    border-color: #1976d2;
    color: #0d47a1;
    text-decoration: none;
}

.page-btn.active {
    background: #1976d2;
    color: #ffffff;
    border-color: #1976d2;
    pointer-events: none;
    box-shadow: 0 2px 6px rgba(25, 118, 210, 0.35);
}

.page-btn.disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
    background: #f8fafc;
    border-color: #e2e8f0;
    color: #94a3b8;
}

.page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 36px;
    color: #94a3b8;
    font-size: 14px;
    user-select: none;
}

.action-btn-sm {
    transition: all 0.2s ease;
    white-space: nowrap;
}

.action-btn-sm:hover {
    background: #37474f !important;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.18);
}

.ticket-actions .delete-btn {
    margin-top: 0 !important;
}

/* Mobile Responsiveness for Search & Pagination */
@media (max-width: 768px) {
    .search-filter-bar {
        padding: 15px;
    }

    .search-filter-bar .filter-row {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
    }

    .search-filter-bar .search-group {
        width: 100%;
        min-width: unset;
    }

    .search-filter-bar .filter-controls {
        flex-direction: column;
        width: 100%;
        min-width: unset;
        gap: 10px;
    }

    .search-filter-bar .filter-select-item {
        width: 100%;
        min-width: unset;
    }

    .search-filter-bar .filter-buttons {
        width: 100%;
        justify-content: stretch;
    }

    .search-filter-bar .filter-btn,
    .search-filter-bar .reset-btn {
        flex: 1;
        justify-content: center;
    }

    .pagination-container {
        gap: 4px;
    }

    .page-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        font-size: 12px;
    }
}

/* ==========================================================================
   Customer Satisfaction (CSAT) Rating & Feedback Styles
   ========================================================================== */
.csat-box {
    margin-top: 15px;
    padding: 16px 18px;
    background: #fdfbf7;
    border: 1px solid #f4e8d3;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.03);
}

.csat-prompt-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #8c6b1f;
    margin-bottom: 8px;
}

.csat-prompt-header i {
    color: #f59e0b;
}

.csat-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.star-rating {
    display: inline-flex;
    flex-direction: row-reverse;
    gap: 6px;
    align-items: center;
}

.star-rating input {
    display: none;
}

.star-rating label {
    font-size: 26px;
    color: #d1d5db;
    cursor: pointer;
    transition: color 0.2s ease, transform 0.15s ease;
}

.star-rating label:hover,
.star-rating label:hover ~ label,
.star-rating input:checked ~ label {
    color: #f59e0b;
    transform: scale(1.1);
}

.csat-feedback-input {
    width: 100%;
    box-sizing: border-box;
    padding: 9px 12px;
    border: 1px solid #dcd3c1;
    border-radius: 6px;
    font-size: 13px;
    background: #fff;
    color: #333;
    resize: vertical;
    min-height: 48px;
    outline: none;
}

.csat-feedback-input:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.15);
}

.csat-submit-btn {
    align-self: flex-start;
    padding: 8px 16px;
    background: #f59e0b;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.2s ease;
}

.csat-submit-btn:hover {
    background: #d97706;
}

/* Rated Display Box */
.csat-display {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.csat-stars-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: #92400e;
}

.csat-stars-gold {
    color: #f59e0b;
    font-size: 16px;
    letter-spacing: 2px;
}

.csat-comment {
    font-size: 13px;
    color: #4b5563;
    font-style: italic;
    background: #fff;
    border-left: 3px solid #f59e0b;
    padding: 6px 12px;
    border-radius: 4px;
    margin-top: 4px;
}

.csat-date {
    font-size: 11px;
    color: #9ca3af;
}

.csat-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 9px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fde68a;
}

/* ==========================================================================
   Reopened Status & Ticket Reopen Styles
   ========================================================================== */
.status-reopened {
    background: #7c3aed !important;
    color: #ffffff !important;
}

.reopen-banner {
    background: #f5f3ff;
    border: 1.5px solid #ddd6fe;
    border-left: 4px solid #7c3aed;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 14px 0;
    color: #4c1d95;
    font-size: 13px;
    line-height: 1.6;
}

.reopen-banner-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    margin-bottom: 4px;
    color: #5b21b6;
}

.reopen-action-btn {
    background: #7c3aed;
    color: #ffffff;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.2s ease, transform 0.15s ease;
    text-decoration: none;
}

.reopen-action-btn:hover {
    background: #6d28d9;
    transform: translateY(-1px);
    color: #ffffff;
}

.reopen-modal-card {
    display: none;
    margin-top: 14px;
    padding: 16px;
    background: #faf5ff;
    border: 1.5px dashed #c084fc;
    border-radius: 8px;
    animation: fadeInModal 0.2s ease-in-out;
}

@keyframes fadeInModal {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   In-Progress Status & Banner Styles
   ========================================================================== */
.status-inprogress {
    background: #0284c7 !important;
    color: #ffffff !important;
}

.inprogress-banner {
    background: #f0f9ff;
    border: 1.5px solid #bae6fd;
    border-left: 4px solid #0284c7;
    border-radius: 8px;
    padding: 12px 16px;
    margin: 14px 0;
    color: #0369a1;
    font-size: 13px;
    line-height: 1.6;
}

.inprogress-banner-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    margin-bottom: 4px;
    color: #0284c7;
}

.inprogress-action-btn {
    background: #0284c7;
    color: #ffffff;
    border: none;
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.2s ease, transform 0.15s ease;
    text-decoration: none;
}

.inprogress-action-btn:hover {
    background: #0369a1;
    transform: translateY(-1px);
    color: #ffffff;
}

/* ==========================================================================
   Comprehensive Mobile & Tablet Responsiveness (All Screens 320px - 992px)
   ========================================================================== */

@media (max-width: 992px) {
    .dashboard-container,
    .portal-container {
        padding: 28px 20px;
        width: 96%;
    }
}

@media (max-width: 768px) {
    /* Navbar Mobile Layout */
    .navbar {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        padding: 12px 16px;
        text-align: center;
    }

    .navbar h3 {
        font-size: 18px;
        text-align: center;
        margin: 0;
    }

    .nav-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .nav-links a {
        margin: 0;
        font-size: 13px;
        padding: 6px 12px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

    .nav-links a:hover {
        background: rgba(255, 255, 255, 0.22);
    }

    .nav-links a.active {
        background: rgba(255, 255, 255, 0.32);
        border-bottom: none;
        font-weight: 700;
    }

    .logout-link {
        background: #d32f2f !important;
        margin-left: 0 !important;
    }

    /* Main Content & Containers */
    .main-content {
        padding: 24px 12px !important;
    }

    .dashboard-container,
    .portal-container {
        width: 100% !important;
        max-width: 100% !important;
        padding: 22px 16px !important;
        border-radius: 10px;
    }

    /* Customer Dashboard Elements */
    .stats {
        flex-direction: column;
        gap: 12px;
    }

    .card-link {
        min-width: 100% !important;
        width: 100% !important;
    }

    .card {
        padding: 16px 18px !important;
    }

    .card h3 {
        font-size: 32px !important;
    }

    .ticket-subject-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .ticket-footer {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    /* Tickets Lists & Cards */
    .ticket {
        border-width: 2px !important;
        padding: 16px 14px !important;
        border-radius: 10px !important;
        margin-bottom: 16px !important;
    }

    .ticket-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .customer-name {
        font-size: 18px !important;
    }

    .ticket-subject {
        font-size: 17px !important;
    }

    .ticket-actions {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 8px;
    }

    .ticket-actions a,
    .ticket-actions button,
    .delete-btn,
    .reopen-action-btn,
    .inprogress-action-btn {
        width: 100% !important;
        justify-content: center !important;
        text-align: center !important;
        box-sizing: border-box;
    }

    /* Form Fields & Touch Targets */
    input, select, textarea, button {
        font-size: 14px !important;
    }

    .reply-btn {
        width: 100% !important;
        text-align: center !important;
        justify-content: center !important;
    }

    /* Attachment Cards on Mobile */
    .attachment-image-link {
        width: 100% !important;
        max-width: 100% !important;
    }

    .attachment-image-thumb {
        height: 160px !important;
    }

    /* CSAT Form on Mobile */
    .csat-box {
        padding: 14px 12px;
    }

    .csat-submit-btn {
        width: 100%;
        justify-content: center;
    }

    /* Analytics Dashboard on Tablet/Mobile */
    .analytics-page {
        padding: 0 10px 40px !important;
        margin: 15px auto !important;
    }

    .kpi-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
    }

    .kpi-card {
        padding: 14px 12px !important;
    }

    .kpi-value {
        font-size: 24px !important;
    }

    .week-strip {
        flex-direction: column;
        gap: 10px;
    }

    .week-card {
        min-width: 100% !important;
        width: 100% !important;
    }

    .chart-canvas-wrap {
        height: 220px !important;
    }

    .table-card {
        padding: 16px 12px !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
    }

    .analytics-table th,
    .analytics-table td {
        padding: 8px 10px !important;
        font-size: 12px !important;
        white-space: nowrap;
    }
}

@media (max-width: 480px) {
    /* Extra-small Phone Breakpoint (320px - 480px) */
    .navbar {
        padding: 10px 12px;
    }

    .navbar h3 {
        font-size: 16px;
    }

    .nav-links a {
        font-size: 12px;
        padding: 5px 8px;
    }

    .main-content {
        padding: 16px 8px !important;
    }

    .dashboard-container,
    .portal-container {
        padding: 16px 10px !important;
        border-radius: 8px;
    }

    .container {
        padding: 20px 15px !important;
    }

    h2 {
        font-size: 19px !important;
    }

    .kpi-grid {
        grid-template-columns: 1fr !important;
    }

    .ticket {
        padding: 12px 10px !important;
    }

    .card h3 {
        font-size: 26px !important;
    }

    .ticket-meta-badges {
        gap: 5px;
    }

    .category-tag,
    .priority-badge {
        font-size: 11px;
        padding: 3px 7px;
    }

    .upload-preview-thumb {
        width: 48px !important;
        height: 48px !important;
        min-width: 48px !important;
    }

    .upload-preview-info {
        max-width: 140px;
    }
}

/* Notification & Unread Badges */
.nav-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ef4444;
    color: #ffffff !important;
    font-size: 11px;
    font-weight: 800;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    margin-left: 6px;
    line-height: 1;
    vertical-align: middle;
    box-shadow: 0 2px 5px rgba(239, 68, 68, 0.4);
}

.card {
    position: relative;
}

.card-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    background: #ef4444;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.35);
    z-index: 2;
}

/* ==========================================================================
   Customer Ticket Cards, Hover Feedback, and Rating Extensions
   ========================================================================== */

/* Ticket Card Hover Feedback (smooth transition, subtle shadow lift, border highlight, no layout shift) */
.ticket {
    position: relative;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
}

.ticket:hover {
    border-color: #93c5fd;
    box-shadow: 0 8px 22px rgba(25, 118, 210, 0.1);
    transform: translateY(-2px);
}

.ticket:active {
    transform: translateY(0);
    box-shadow: 0 2px 6px rgba(25, 118, 210, 0.06);
}

/* Deep link glow highlight */
.ticket-highlighted {
    border: 2px solid #1976d2 !important;
    box-shadow: 0 0 0 4px rgba(25, 118, 210, 0.25) !important;
    animation: customerTicketPulse 2s ease-in-out infinite alternate;
}

@keyframes customerTicketPulse {
    0% { box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.2); }
    100% { box-shadow: 0 0 0 6px rgba(25, 118, 210, 0.45); }
}

/* CSAT Rating Actions & Badges */
.btn-csat-change {
    background: #f8fafc;
    color: #1976d2;
    border: 1px solid #cbe2ff;
    padding: 5px 11px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
}

.btn-csat-change:hover {
    background: #1976d2;
    color: #ffffff;
    border-color: #1976d2;
}

.btn-csat-remove {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
    padding: 5px 11px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
}

.btn-csat-remove:hover {
    background: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
}

.badge-updated {
    font-size: 10px;
    background: #f3e8ff;
    color: #7e22ce;
    padding: 2px 7px;
    border-radius: 10px;
    font-weight: 700;
    margin-left: 4px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
}

/* Re-resolve Rating Prompt */
.csat-re-resolve-prompt {
    background: #fffbeb;
    border: 1px solid #fef3c7;
    border-left: 4px solid #f59e0b;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 12px;
}

.csat-re-resolve-prompt .prompt-header {
    font-size: 13px;
    font-weight: 700;
    color: #92400e;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
}

.csat-re-resolve-prompt .prompt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
}

.btn-prompt-update {
    background: #f59e0b;
    color: #ffffff;
    border: none;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: background 0.2s ease;
}

.btn-prompt-update:hover {
    background: #d97706;
}

.btn-prompt-keep {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #cbd5e1;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
}

.btn-prompt-keep:hover {
    background: #e2e8f0;
    color: #1e293b;
}

.btn-prompt-remove {
    background: transparent;
    color: #dc2626;
    border: none;
    padding: 5px 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: underline;
}

.btn-prompt-remove:hover {
    color: #991b1b;
}


